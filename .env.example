# Telegram application credentials from https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace_me

# Comma-separated list of chat IDs that should receive notifications
IDS_TO_CHAT=123456789,987654321

# Optional: comma-separated list of Telegram channels to monitor
MONITOR_CHANNELS=@codeforces_official,@olymp_itmo11,@olymp_mephi

# DeepSeek browser automation is fragile. Keep enabled only if you accept that dependency.
DEEPSEEK_ENABLED=true
DEEPSEEK_HEADLESS=false
DEEPSEEK_COOKIES_FILE=.runtime/deepseek_cookies.pkl
DEEPSEEK_MAX_CHECKS_BEFORE_RESTART=5
